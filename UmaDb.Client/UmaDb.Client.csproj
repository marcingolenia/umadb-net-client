<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <PackageId>UmaDb.Client</PackageId>
        <Version>0.6.6</Version>
        <Title>UmaDb .NET Client</Title>
        <Authors>UmaDb .NET Client Contributors</Authors>
        <Company>UmaDb</Company>
        <!-- Description (surfaced on NuGet.org) -->
        <Description>A high-performance .NET client for UmaDB, designed for Dynamic Consistency Boundaries (DCB). Compatible with .NET trimming and AOT.</Description>
        <PackageTags>umadb;grpc;event-sourcing;dcb;dynamic-consistency;event-store</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/marcingolenia/umadb-net-client</PackageProjectUrl>
        <RepositoryUrl>https://github.com/marcingolenia/umadb-net-client</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <Copyright>Copyright (c) 2026 UmaDb .NET Client Contributors</Copyright>
        <PackageReleaseNotes>See https://github.com/marcingolenia/umadb-net-client/releases</PackageReleaseNotes>
    </PropertyGroup>
    <ItemGroup>
      <!-- SDK-style pack turns ProjectReference into a package dependency; UmaDb.Core is not published to NuGet.
           PrivateAssets="all" keeps it out of the nuspec. We include its DLL via IncludeReferencedProjectOutput below. -->
      <ProjectReference Include="..\UmaDb.Core\UmaDb.Core.fsproj" PrivateAssets="all" />
      <PackageReference Include="protobuf-net.Grpc" />
      <!-- UmaDb.Core runtime deps (Core is embedded via _PackageFiles; refs don't flow so we declare them here) -->
      <PackageReference Include="FSharp.Core" />
      <PackageReference Include="Grpc.Net.Client" />
      <PackageReference Include="System.Security.Cryptography.Pkcs" />
    </ItemGroup>
    <!-- Include referenced project output in package (SDK equivalent of nuget pack -IncludeReferencedProjects). -->
    <Target Name="IncludeReferencedProjectOutput" AfterTargets="Build" BeforeTargets="GenerateNuspec">
      <PropertyGroup>
        <_CoreDllPath>$(MSBuildProjectDirectory)/../UmaDb.Core/bin/$(Configuration)/$(TargetFramework)/UmaDb.Core.dll</_CoreDllPath>
      </PropertyGroup>
      <ItemGroup>
        <_PackageFiles Include="$(_CoreDllPath)" Condition="Exists('$(_CoreDllPath)')">
          <PackagePath>lib/$(TargetFramework)/</PackagePath>
        </_PackageFiles>
      </ItemGroup>
    </Target>
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="readme.md"/>
        <None Include="..\logo.png" Pack="true" PackagePath="logo.png"/>
    </ItemGroup>
</Project>
