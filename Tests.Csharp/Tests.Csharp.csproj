<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Grpc.Net.Client" />
        <PackageReference Include="Protobuf.Grpc.ClientFactory" />
        <PackageReference Include="Testcontainers" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\UmaDb.Client\UmaDb.Client.csproj" />
      <!-- Required for types from Client API that are defined in Core (e.g. AppendResponse); Client's ref has PrivateAssets="all" so it doesn't flow -->
      <ProjectReference Include="..\UmaDb.Core\UmaDb.Core.fsproj" />
    </ItemGroup>
    <ItemGroup>
      <!-- Unify with UmaDb.Core: avoid System.ServiceModel.Primitives 4.x from other test deps -->
      <PackageReference Include="System.ServiceModel.Primitives" />
    </ItemGroup>
    <ItemGroup>
      <None Update="certs\server.pem">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="certs\server-key.pem">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="certs\ca.pem">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="certs\ca-key.pem">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
</Project>